# NIMA environment variables — copy this file to `.env` and fill in real values.
# Anything left commented out falls back to the default in `config.py`.

# ─── OpenAI (required for default generation/review pipeline) ──────────────────
OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_TIMEOUT=120
# GENERATION_MODEL=gpt-5.2-codex
# FAST_MODEL=gpt-5.2-codex

# ─── Streaming providers (optional fallbacks for scene-by-scene mode) ─────────
# Leave any of these empty to skip the provider in the auto-selection chain.
ZJUBAPI_API_KEY=
# ZJUBAPI_BASE_URL=https://ai-cfs.zju.edu.cn
# ZJUBAPI_MODEL=gpt-5.4
# ZJUBAPI_TIMEOUT=45

WENWEN_API_KEY=
# WENWEN_BASE_URL=https://api.wenwen-ai.com
# WENWEN_MODEL=claude-opus-4-6
# WENWEN_TIMEOUT=45

# Provider selection: auto | zjuapi | wenwen | openai
# STREAM_PROVIDER=auto

# ─── Filesystem ───────────────────────────────────────────────────────────────
# Defaults are Windows-friendly (C:/temp/...). Override on Linux/macOS.
# MANIM_SCRIPTS=C:/temp/manim_scripts
# OUTPUTS=C:/temp/outputs

# ─── Database (optional) ──────────────────────────────────────────────────────
# Set USE_DATABASE=true and DB_CONNECTION_STRING to enable Postgres-backed
# job/usage persistence. Leave USE_DATABASE=false for in-memory state.
USE_DATABASE=false
# DB_CONNECTION_STRING=postgresql://user:password@localhost:5432/manim_db

# ─── Pipeline tuning ──────────────────────────────────────────────────────────
# FAST_PIPELINE=false    # skip review pass unless critical errors
# DRAFT_PIPELINE=false   # ultra-low-fidelity preview render
# SHORT_DRAFT_FAST_PATH=false
# RENDER_CACHE_ENABLED=true
# PROMPT_CACHE_ENABLED=true

# ─── Voiceover (TTS) ──────────────────────────────────────────────────────────
# Default uses edge-tts (free, no API key). Override only if you swap providers.
# TTS_API_KEY=
# TTS_BASE_URL=
ENABLE_VOICEOVER=true

# ─── Job state / workers ──────────────────────────────────────────────────────
# JOB_STATE_PERSISTENCE=true
# JOB_STATE_PATH=
# BACKGROUND_MAX_WORKERS=2
# WEBHOOK_MAX_WORKERS=4

# ─── CDN (optional) ───────────────────────────────────────────────────────────
# CDN_BASE_URL=https://cdn.example.com/videos
