# NIMA environment variables — copy this file to `.env` and fill in real values.
# Anything left commented out falls back to the default in `config.py`.

# ─── OpenAI (required for default generation/review pipeline) ──────────────────
OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_TIMEOUT=120
# GENERATION_MODEL=gpt-5.2-codex
# FAST_MODEL=gpt-5.2-codex

# ─── Streaming providers (optional fallbacks for scene-by-scene mode) ─────────
# Leave any of these empty to skip the provider in the auto-selection chain.
ZJUBAPI_API_KEY=
# ZJUBAPI_BASE_URL=https://ai-cfs.zju.edu.cn
# ZJUBAPI_MODEL=gpt-5.4
# ZJUBAPI_TIMEOUT=45

WENWEN_API_KEY=
# WENWEN_BASE_URL=https://api.wenwen-ai.com
# WENWEN_MODEL=claude-opus-4-6
# WENWEN_TIMEOUT=45

# Provider selection: auto | zjuapi | wenwen | openai
# STREAM_PROVIDER=auto
# Cross-provider failover knobs (consumed by algorithms.streaming via config.py).
# STREAM_PROVIDER_FAILURE_COOLDOWN=180
# STREAM_PROVIDER_TOTAL_TIMEOUT=120
# STREAM_PROVIDER_USE_SUBPROCESS=true   # run LLM call in a child process so timeout kills are real

# ─── Request analysis (planning LLM call) ─────────────────────────────────────
# REQUEST_ANALYSIS_TIMEOUT=60           # seconds
# REQUEST_ANALYSIS_USE_SUBPROCESS=true

# ─── Filesystem ───────────────────────────────────────────────────────────────
# Defaults are Windows-friendly (C:/temp/...). Override on Linux/macOS.
# MANIM_SCRIPTS=C:/temp/manim_scripts
# OUTPUTS=C:/temp/outputs

# ─── Database (optional) ──────────────────────────────────────────────────────
# Set USE_DATABASE=true and DB_CONNECTION_STRING to enable Postgres-backed
# job/usage persistence. Leave USE_DATABASE=false for in-memory state.
USE_DATABASE=false
# DB_CONNECTION_STRING=postgresql://user:password@localhost:5432/manim_db

# ─── LLM fallback (optional) ─────────────────────────────────────────────────
# When the primary LLM endpoint returns a 524 gateway timeout, ai_functions
# retries the call against a second endpoint. Default is OpenAI gpt-4o-mini;
# override to pin a different rescue model.
# LLM_FALLBACK_MODEL=gpt-4o-mini
# LLM_FALLBACK_BASE_URL=https://api.openai.com/v1
# LLM_FALLBACK_API_KEY=

# ─── Pipeline tuning ──────────────────────────────────────────────────────────
# FAST_PIPELINE=false    # skip review pass unless critical errors
# DRAFT_PIPELINE=false   # ultra-low-fidelity preview render
# SHORT_DRAFT_FAST_PATH=false
# RENDER_CACHE_ENABLED=true
# PROMPT_CACHE_ENABLED=true
# MAX_GENERATION_ATTEMPTS=2
# MAX_RENDER_RETRIES=3
# RENDER_TIMEOUT_SECONDS=900

# ─── Voiceover (TTS) ──────────────────────────────────────────────────────────
# Default uses edge-tts (free, no API key). Override only if you swap providers.
# TTS_API_KEY=
# TTS_BASE_URL=
# EDGE_TTS_VOICE=en-US-GuyNeural
ENABLE_VOICEOVER=true

# ─── Job state / workers ──────────────────────────────────────────────────────
# JOB_STATE_PERSISTENCE=true
# JOB_STATE_PATH=
# BACKGROUND_MAX_WORKERS=2
# WEBHOOK_MAX_WORKERS=4

# ─── Rate limiting (optional) ─────────────────────────────────────────────────
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=10
# RATE_LIMIT_WINDOW=60

# ─── CDN (optional) ───────────────────────────────────────────────────────────
# CDN_BASE_URL=https://cdn.example.com/videos

# ─── Internationalization (optional) ──────────────────────────────────────────
# Force on-screen Manim text (Text/Tex/MathTex) and TTS into a non-English
# language across both the streaming-LLM path and the deterministic-fallback
# templates. Value is freeform — any common spelling of the language is
# accepted (e.g. "Kazakh", "kk", "Қазақ тілі").
# Leave unset for English (default).
# NIMA_LANGUAGE_LOCK=Kazakh

# ─── Vision / OCR (optional) ──────────────────────────────────────────────────
# Plug in an out-of-process OCR command for vision-based scene checks. NIMA
# shlex-splits the value, appends the image path as the last argument, and
# expects OCR output on stdout (plain text or a JSON payload with 'text' and
# 'boxes'). Example invoking Tesseract with stdout capture:
# NIMA_OCR_COMMAND=tesseract stdout -l eng
